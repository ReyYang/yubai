// 免费 Apple Developer / Personal Team 也支持 App Groups，默认共享小组件快照。
// https://developer.apple.com/help/account/reference/supported-capabilities-ios
// Config/Local.xcconfig 在本文件之后加载，可设为 NO 回退为仅显示入口。
YUBAI_APP_GROUP = YES
YUBAI_APP_GROUP_IDENTIFIER = group.app.yubai.personal
YUBAI_APP_GROUP_CONDITION_NO =
YUBAI_APP_GROUP_CONDITION_YES = YUBAI_APP_GROUP
YUBAI_IOS_ENTITLEMENTS_NO_NO =
YUBAI_IOS_ENTITLEMENTS_NO_YES = Sources/YubaiApp/Yubai-AppGroup.entitlements
YUBAI_IOS_ENTITLEMENTS_YES_NO = Sources/YubaiApp/Yubai-iCloud.entitlements
YUBAI_IOS_ENTITLEMENTS_YES_YES = Sources/YubaiApp/Yubai-iCloud-AppGroup.entitlements
YUBAI_WIDGET_ENTITLEMENTS_NO =
YUBAI_WIDGET_ENTITLEMENTS_YES = Sources/YubaiWidgets/YubaiWidgets.entitlements
