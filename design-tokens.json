      "light": "#F5F1E5",
      "dark": "#1F1B14",
      "usage": "页面底。整个 App 只有这一种底色。"
    },
    "surface": {
      "light": "#EDE6D3",
      "dark": "#2A251C",
      "usage": "「一块」：胶囊、按钮、空格子、问余白条、键盘托盘里的块、没选中的分类圆。"
    },
    "raised": {
      "light": "#FEFBEA",
      "dark": "#353026",
