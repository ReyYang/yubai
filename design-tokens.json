        "usage": "账单行首次出现：上移 8pt 淡入，每行晚 0.04s 开始（只是起步延迟，不是时长）。"
      },
      "bar-grow": {
        "spring": "standard",
        "staggerDelay": 0.012,
        "usage": "日线柱首次长出。"
      },
      "number": {
        "spring": "standard",
        "transition": "numericText",
        "usage": "数字变化：.contentTransition(.numericText())，只换变了的位。"
      },
      "float-card": {
        "spring": "bouncy",
        "usage": "浮动账单卡出现（缩放 0.96 → 1 + 淡入）。"
      },
      "sheet": {
        "spring": "system",
        "usage": "底部弹窗用系统 .sheet 自带弹簧，不自定义。"
      }
    },
    "haptics": {
      "save": "success",
      "overspend": "warning",
      "toggle": "selection"
    },
    "loops": {
      "$comment": "循环动画：SwiftUI 用 PhaseAnimator / KeyframeAnimator，相位之间用这里的弹簧。",
      "breathe": {
        "phases": [
          1.0,
          0.55
        ],
        "property": "opacity",
        "spring": "smooth",
        "hold": 0.6,
        "usage": "AI 正在想、读取中。"
      },
      "shimmer": {
        "phases": [
          -1.0,
          1.0
        ],
        "property": "offsetX",
        "spring": "smooth",
        "hold": 0.4,
        "usage": "骨架屏扫光。"
      }
    },
    "reduceMotion": {
      "spring": "smooth",
      "allow": [
        "opacity"
      ],
      "usage": "减弱动态效果：去掉位移、缩放、回弹，只留淡入淡出；数字直接跳。"
    }
  }
