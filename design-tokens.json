  "typography": {
    "$comment": "family: text = 系统 SF Pro（中文苹方），num = SF Pro Rounded + 等宽数字（.monospacedDigit()）。weight 只允许 regular / medium / semibold。lineHeight 是行盒高度，SwiftUI 端用 lineSpacing + 上下补齐还原。relativeTo 决定动态字体跟哪一档放大。",
    "families": {
      "text": {
        "swift": "default",
        "css": "-apple-system, \"SF Pro Text\", \"PingFang SC\", system-ui, sans-serif"
      },
      "num": {
        "swift": "rounded",
        "css": "ui-rounded, \"SF Pro Rounded\", -apple-system, \"PingFang SC\", system-ui, sans-serif",
        "monospacedDigit": true
      }
    },
